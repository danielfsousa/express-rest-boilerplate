{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug API (apps/api)",
      "cwd": "${workspaceFolder}/apps/api",
      "runtimeArgs": ["--inspect", "--watch", "--env-file-if-exists=../../.env"],
      "program": "${workspaceFolder}/apps/api/src/index.ts",
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Worker (apps/worker)",
      "cwd": "${workspaceFolder}/apps/worker",
      "runtimeArgs": ["--inspect", "--watch", "--env-file-if-exists=../../.env"],
      "program": "${workspaceFolder}/apps/worker/src/index.ts",
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug current Vitest file",
      "cwd": "${workspaceFolder}",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "vp", "test", "run", "${relativeFile}"],
      "smartStep": true,
      "console": "integratedTerminal"
    }
  ],
  "compounds": []
}
