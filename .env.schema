# @defaultSensitive=false @defaultRequired=infer
# @currentEnv=$APP_ENV
# @generateTsTypes(path=./env.d.ts)
# ---

# Active deployment environment (only local and prod are used)
# @type=enum(local, prod)
APP_ENV=local

# Node.js runtime mode derived from APP_ENV unless explicitly overridden (e.g. test runner)
# @type=enum(development, test, production)
NODE_ENV=if(eq($APP_ENV, prod), production, development)

# Bind address for the API HTTP and WebSocket server
HOST=127.0.0.1

# Listen port for the API server
# @type=port
PORT=3001

# Pino minimum log level
# @type=enum(fatal, error, warn, info, debug, trace, silent)
LOG_LEVEL=info

# Log output format
# @type=enum(json, pretty)
LOG_FORMAT=pretty

# Export OpenTelemetry traces and metrics
# @type=boolean
OTEL_ENABLED=false

# Service name reported to the OpenTelemetry collector
OTEL_SERVICE_NAME=bookstore-api

# Base URL for the OTLP HTTP collector (otel-lgtm or Grafana Cloud)
# @type=url
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Optional comma-separated key=value headers for Grafana Cloud OTLP auth
# @sensitive=forEnv(prod) @optional
OTEL_EXPORTER_OTLP_HEADERS=

# Application database connection string (NOSUPERUSER NOBYPASSRLS)
# @sensitive=forEnv(prod) @required
DATABASE_URL=if(forEnv(local), "postgres://app_user:app_password@127.0.0.1:5432/bookstore", "")

# Non-pooled database connection string for PostgreSQL LISTEN/NOTIFY and pg-boss
# @sensitive=forEnv(prod) @optional
DATABASE_DIRECT_URL=if(forEnv(local), "postgres://app_user:app_password@127.0.0.1:5432/bookstore", "")

# Schema owner database connection string for Drizzle migrations
# @sensitive=forEnv(prod) @optional
DATABASE_ADMIN_URL=if(forEnv(local), "postgres://postgres:postgres@127.0.0.1:5432/bookstore", "")

# Run background jobs in-process inside the API instead of a separate worker
# @type=boolean
WORKER_INLINE=false

# Signing secret for better-auth sessions (minimum 16 characters)
# @sensitive=forEnv(prod) @required @type=string(minLength=16)
BETTER_AUTH_SECRET=if(forEnv(local), "dev-only-secret-change-in-production-32chars", "")

# Public base URL of the authentication server
# @type=url
BETTER_AUTH_URL=http://127.0.0.1:3001

# Allowed CORS origin and redirect target for the web app
# @type=url
WEB_ORIGIN=http://127.0.0.1:3000

# S3 or Cloudflare R2 endpoint URL (Floci locally)
# @type=url
S3_ENDPOINT=http://127.0.0.1:4566

# S3 region (use "auto" on Cloudflare R2)
S3_REGION=us-east-1

# S3 or Cloudflare R2 access key ID
# @sensitive=forEnv(prod) @required
S3_ACCESS_KEY_ID=if(forEnv(local), "local-floci-access-key", "")

# S3 or Cloudflare R2 secret access key
# @sensitive=forEnv(prod) @required
S3_SECRET_ACCESS_KEY=if(forEnv(local), "local-floci-secret-key", "")

# Bucket name for book cover uploads and CSV exports
S3_BUCKET=bookstore-media

# Bird.com API base URL (points to local emulator in local environment)
# @type=url
BIRD_API_BASE_URL=http://127.0.0.1:4010

# Bird.com API bearer token
# @sensitive=forEnv(prod) @required
BIRD_API_KEY=if(forEnv(local), "local-bird-dev-api-key", "")

# Verified sender address for transactional emails
# @type=email
BIRD_FROM_EMAIL=noreply@bookstore.local

# Port for the local Bird.com HTTP email capture emulator
# @type=port
BIRD_EMULATOR_PORT=4010

# Stripe secret key
# @sensitive=forEnv(prod) @required
STRIPE_SECRET_KEY=if(forEnv(local), "sk_test_local_emulate_key", "")

# Stripe webhook signing secret
# @sensitive=forEnv(prod) @required
STRIPE_WEBHOOK_SECRET=if(forEnv(local), "whsec_local_emulate_secret", "")

# Optional Stripe API host override for vercel-labs/emulate
# @optional
STRIPE_API_HOST=127.0.0.1

# Optional Stripe API port override for vercel-labs/emulate
# @type=port @optional
STRIPE_API_PORT=4009

# Optional Stripe API protocol override for vercel-labs/emulate
# @type=enum(http, https) @optional
STRIPE_API_PROTOCOL=http

# Stripe recurring Price ID for the Pro store subscription plan
STRIPE_PRO_PRICE_ID=price_pro_monthly

# Enable multi-store creation and store switching
# @type=boolean
FEATURE_MULTI_TENANCY_ENABLED=true

# Enable SaaS platform admin API, store plan overrides, and user impersonation
# @type=boolean
FEATURE_ADMIN_ENABLED=true

# Enable Stripe checkout sessions, subscriptions, and webhooks
# @type=boolean
FEATURE_BILLING_ENABLED=true

# Enable pg-boss queues and /api/v1/stores/:storeSlug/exports endpoints
# @type=boolean
FEATURE_JOBS_ENABLED=true

# Enable /api/v1/stores/:storeSlug/ws WebSocket push notifications
# @type=boolean
FEATURE_REALTIME_ENABLED=true

# Realtime event broker (memory or postgres for multi-instance LISTEN/NOTIFY)
# @type=enum(memory, postgres)
REALTIME_BROKER=memory

# Enable Paraglide locale switching (en and pt-BR)
# @type=boolean
FEATURE_I18N_ENABLED=true

# Frontend Vite API base URL
# @type=url
VITE_API_URL=http://127.0.0.1:3001

# Frontend multi-tenancy feature toggle
# @type=boolean
VITE_FEATURE_MULTI_TENANCY_ENABLED=true

# Frontend SaaS admin feature toggle
# @type=boolean
VITE_FEATURE_ADMIN_ENABLED=true

# Frontend billing feature toggle
# @type=boolean
VITE_FEATURE_BILLING_ENABLED=true

# Frontend realtime WebSocket feature toggle
# @type=boolean
VITE_FEATURE_REALTIME_ENABLED=true

# Frontend i18n locale switcher feature toggle
# @type=boolean
VITE_FEATURE_I18N_ENABLED=true
