{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": [
    "env.d.ts",
    "playwright.config.ts",
    "vite.config.ts",
    "e2e/**/*.ts",
    "scripts/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "apps/*/test/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "packages/ui/.storybook/**/*.ts",
    "packages/ui/.storybook/**/*.tsx",
    "packages/ui/vite.config.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.output/**",
    "**/storybook-static/**"
  ]
}
