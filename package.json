{
  "name": "ts-blueprint",
  "version": "2.0.0",
  "private": true,
  "description": "Full-stack TypeScript monorepo starter implementing a multi-tenant bookstore platform",
  "license": "MIT",
  "author": {
    "name": "Daniel Sousa",
    "email": "sousa.dfs@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:danielfsousa/express-rest-boilerplate.git"
  },
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:api": "vp run @starter/api#dev",
    "dev:web": "vp run @starter/web#dev",
    "dev:worker": "vp run @starter/worker#dev",
    "dev:emulators": "vp run --cache -t @starter/email#build && node scripts/dev-emulators.ts",
    "email:templates:upload": "vp run @starter/email#templates:upload",
    "email:templates:validate": "vp run @starter/email#templates:validate",
    "email:templates:dry-run": "vp run @starter/email#templates:dry-run",
    "build": "vp run --cache -r build",
    "storybook": "vp run @starter/ui#storybook",
    "storybook:build": "vp run --cache @starter/ui#storybook:build",
    "check": "vp run task:check",
    "check:fix": "vp check --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp run task:lint",
    "typecheck": "vp run task:typecheck",
    "cache:clean": "vp cache clean",
    "env:check": "varlock load",
    "env:codegen": "varlock codegen",
    "env:scan": "varlock scan",
    "test": "vp test run",
    "test:cov": "vp test run --coverage",
    "test:e2e": "playwright test",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "^0.1.0",
    "@playwright/test": "^1.65.1",
    "@starter/email": "workspace:*",
    "@starter/runtime": "workspace:*",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "catalog:",
    "emulate": "catalog:",
    "typescript": "^5.8.0",
    "varlock": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
