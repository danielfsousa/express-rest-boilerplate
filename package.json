{
  "name": "nodejs-fullstack-starter",
  "version": "2.0.0",
  "private": true,
  "description": "Full-stack TypeScript monorepo starter implementing a multi-tenant bookstore platform",
  "license": "MIT",
  "author": {
    "name": "Daniel Sousa",
    "email": "sousa.dfs@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:danielfsousa/express-rest-boilerplate.git"
  },
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:api": "pnpm --filter @starter/api dev",
    "dev:emulators": "node scripts/dev-emulators.ts",
    "build": "vp run build",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "TSRS_FAST=1 oxlint --type-aware --type-check",
    "typecheck": "tsrs --noEmit --fast",
    "test": "vp test run",
    "test:cov": "vp test run --coverage",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "^0.1.0",
    "@starter/email": "workspace:*",
    "@starter/runtime": "workspace:*",
    "@types/node": "^22.10.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsrs": "7.1.0-beta.tsrs4",
    "typescript": "^5.8.0",
    "vite-plus": "^1.7.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
